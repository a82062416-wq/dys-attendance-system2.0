{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Python HTTP Server (Port 8000)",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "8000"],
      "port": 8000
    },
    {
      "name": "Python HTTP Server (Port 3000)",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "3000"],
      "port": 3000
    },
    {
      "name": "Python SimpleHTTPServer (Python 2)",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "SimpleHTTPServer", "8000"],
      "port": 8000
    },
    {
      "name": "Node.js HTTP Server (http-server)",
      "runtimeExecutable": "http-server",
      "runtimeArgs": ["-p", "3000"],
      "port": 3000
    },
    {
      "name": "Node.js HTTP Server (npx)",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["http-server", "-p", "3000"],
      "port": 3000
    }
  ]
}
